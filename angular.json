{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "npm"
	},
	"newProjectRoot": "projects",
	"projects": {
		"bankaccount-mfe": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": [
							"src/styles.scss"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "bankaccount-mfe:build:production"
						},
						"development": {
							"buildTarget": "bankaccount-mfe:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"test": {
					"builder": "@angular/build:unit-test"
				}
			}
		},
		"bankaccount-host": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/bankaccount-host",
			"sourceRoot": "projects/bankaccount-host/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation-v4:build",
					"options": {
						"cacheExternalArtifacts": true,
						"tsConfig": "projects/bankaccount-host/tsconfig.federation.json"
					},
					"configurations": {
						"production": {
							"target": "bankaccount-host:esbuild:production"
						},
						"development": {
							"target": "bankaccount-host:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation-v4:build",
					"options": {
						"target": "bankaccount-host:serve-original:development",
						"tsConfig": "projects/bankaccount-host/tsconfig.federation.json",
						"rebuildDelay": 500,
						"cacheExternalArtifacts": true,
						"dev": true,
						"devServer": true,
						"port": 0
					}
				},
				"test": {
					"builder": "@angular/build:unit-test"
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "projects/bankaccount-host/src/main.ts",
						"tsConfig": "projects/bankaccount-host/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/bankaccount-host/public"
							}
						],
						"styles": [
							 "node_modules/bootstrap/dist/css/bootstrap.min.css",
							  "./node_modules/@flaticon/flaticon-uicons/css/all/all.css",
							"projects/bankaccount-host/src/styles.scss"
						],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2MB",
									"maximumError": "3MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "bankaccount-host:esbuild:production"
						},
						"development": {
							"buildTarget": "bankaccount-host:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200
					}
				}
			}
		},
		"dashboard-mfe": {
  "projectType": "application",
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "root": "projects/dashboard-mfe",
  "sourceRoot": "projects/dashboard-mfe/src",
  "prefix": "app",
  "architect": {
    "build": {
      "builder": "@angular-architects/native-federation-v4:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "projects/dashboard-mfe/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "dashboard-mfe:esbuild:production"
        },
        "development": {
          "target": "dashboard-mfe:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },

    "serve": {
      "builder": "@angular-architects/native-federation-v4:build",
      "options": {
        "target": "dashboard-mfe:serve-original:development",
        "tsConfig": "projects/dashboard-mfe/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },

    "test": {
      "builder": "@angular/build:unit-test"
    },

    "esbuild": {
      "builder": "@angular/build:application",
      "options": {
        "browser": "projects/dashboard-mfe/src/main.ts",
        "tsConfig": "projects/dashboard-mfe/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "projects/dashboard-mfe/public"
          }
        ],
        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "projects/dashboard-mfe/src/styles.scss"
        ],
        "polyfills": [
          "es-module-shims"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all"
        },

        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "projects/dashboard-mfe/src/environments/environment.ts",
              "with": "projects/dashboard-mfe/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },

    "serve-original": {
      "builder": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dashboard-mfe:esbuild:production"
        },
        "development": {
          "buildTarget": "dashboard-mfe:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      }
    }
  }
},
